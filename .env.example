# ── Google ───────────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Firestore
GCP_PROJECT=your_gcp_project_id
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=meli_stores

# ── Mercado Livre (APP ÚNICA para todas as lojas) ─────────────────────────────
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://SEU-CLOUD-RUN/auth/meli/callback

# ── App ───────────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=trocar_por_string_aleatoria_segura
PORT=8080

# ── Web app (Mural/Embalagem/Gaiolas) ─────────────────────────────────────────
MURAL_PASSWORD=trocar_por_senha_forte
SESSION_SECRET_KEY=trocar_por_string_aleatoria_segura
SESSION_COOKIE_HTTPS_ONLY=true

# Nomes exatos das impressoras (Windows) usadas na tela de Embalagem.
# Vazio = usa a impressora padrão do Windows (útil pra testar com só 1 impressora).
PRINTER_PEDIDO_NAME=
PRINTER_MELI_NAME=

# Impressora comum (Wi-Fi, não térmica) usada pra guia de retirada de gaiola
# (documento de página inteira, não etiqueta ZPL). Vazio = impressora padrão.
PRINTER_GUIA_NAME=

# Tela do Gerente (auditoria/reversão de status/conexão de lojas) — senha própria,
# diferente da MURAL_PASSWORD. Operador do galpão não deve ter essa senha.
GERENTE_PASSWORD=trocar_por_senha_forte
